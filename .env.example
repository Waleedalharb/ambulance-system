# Environment Variables Example
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# Node environment
NODE_ENV=production

# Server port (Render sets this automatically, but good to have locally)
PORT=3002

# JWT Secret - generate with: openssl rand -base64 64
JWT_SECRET=your-very-strong-secret-key-here-minimum-64-characters-long

# Default passwords for first-time setup (will be hashed and stored)
# Set these BEFORE first deployment, then you can remove them from env vars
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password
DEFAULT_DIRECTOR_PASSWORD=your-secure-director-password
DEFAULT_USER_PASSWORD=your-secure-user-password

# Render Disk mount path (set automatically by Render)
RENDER_DISK_PATH=/data

# CORS origin - restrict to your domain in production
CORS_ORIGIN=https://emsoperations.online

# Optional: Backup directory
BACKUP_DIR=/data/backups
